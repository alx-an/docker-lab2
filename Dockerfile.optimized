# Этап сборки: зависимости устанавливаются в отдельный каталог.
FROM python:3.11-slim AS builder

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Этап выполнения: переносим зависимости и исходный код приложения.
FROM python:3.11-slim

LABEL maintainer="andreev@lab.local"
LABEL version="2.0"

WORKDIR /app

# curl используется в HEALTHCHECK. Списки apt удаляются в том же слое.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
COPY app/ ./app/

EXPOSE 5528

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5528/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5528"]
